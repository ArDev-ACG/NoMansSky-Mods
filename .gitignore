# ---------------------------------------------------------------
# NMS_MOD_ZOMBIES — .gitignore
#
# Regla base: al repo solo van FUENTES PROPIAS (scripts lua, docs).
# NUNCA van assets del juego. Son propiedad de Hello Games; subirlos
# a un repo publico es redistribucion no autorizada.
# ---------------------------------------------------------------

# --- Assets del juego / binarios pesados (NUNCA subir) ---
unpacked/
build/
# tools/ es AMUMSS vendored, MBINCompiler y sus .exe: nada de eso va a git.
# Pero los .py de ahi dentro SI son fuente propia y si se versionan. La
# regla tiene que ser "tools/*" y no "tools/": git no puede re-incluir
# nada que este dentro de un directorio excluido.
tools/*
!tools/*.py
!tools/*.ps1
!tools/tests/
tools/tests/*
!tools/tests/*.py
# PCBANKS desempaquetado para NMSDK: assets de Hello Games, y ademas
# MBINCompiler deja .MXML sueltos que las reglas por extension no cazan.
work/pcbanks/
*.pak
*.mbin
*.MBIN
*.exml
*.EXML
*.dds
*.DDS
*.mbin.PC
BankSignatures.bin
# Indice de rutas de los .pak que vuelca MBINCompiler. 15 MB, se regenera
# en un rato, y lleva dentro la ruta local de la instalacion de Steam.
# El filenames-<compilador>-<fecha>.json es la instantanea anterior, que hay
# que guardar en disco antes de cada actualizacion de NMS para poder diffear.
# Ver docs/COSMOS-ASSETS.md §4.
filenames.json
filenames-*.json

# --- Backups de partidas (datos personales, nunca a git) ---
backups/

# --- Material de referencia de terceros (NUNCA subir) ---
# Arte de otros juegos/artbooks para inspiracion visual. Mirarlo es uso
# normal; redistribuirlo en un repo o en un mod no lo es. Se queda en disco.
asset/
assets/
referencia/
reference/
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.bmp
*.tif
*.tiff
# excepcion: capturas propias del mod para el README de Nexus
!docs/screenshots/**

# --- Archivos descargados de herramientas ---
*.7z
*.zip
*.msi
*.exe

# --- Salidas de build de AMUMSS ---
MODS/
ModScript*.txt
REPORT.txt
*.log

# --- Trabajo pesado local (opt-in manual si lo quieres versionar) ---
# Las excepciones van pieza a pieza, y ojo con la forma: para re-incluir un
# archivo hay que abrir TODOS sus directorios padre, porque git no mira
# dentro de un directorio excluido. Por eso "work/models/*" y no
# "work/models/". Con *.blend no hace falta: es un patron de archivo, no de
# directorio, y basta con negar la ruta.
work/models/*
!work/models/scuttlermesh/
work/models/scuttlermesh/*
# El sidecar de pesos: 285 KB de texto, y es lo que consume el splice de
# M-ANIM. Es justo lo que se perdio la primera vez por no versionarlo.
!work/models/scuttlermesh/pesos.json
!work/models/fiendmesh/
work/models/fiendmesh/*
!work/models/fiendmesh/pesos.json
!work/models/zombiemesh/
work/models/zombiemesh/*
!work/models/zombiemesh/pesos.json
# La segunda hornada. Ademas del pesado entra `giros.json`, que es el giro de
# mundo de cada hueso por clip: lo escribe Sway-NMSJoint.py leyendo los .ANIM
# del juego, es propiedad del ESQUELETO y no de la malla, y sin el no se puede
# recalcular ni el agarre ni el tope de vaiven.
!work/models/warriorbugmesh/
work/models/warriorbugmesh/*
!work/models/warriorbugmesh/pesos.json
!work/models/warriorbugmesh/giros.json
!work/models/crywolfmesh/
work/models/crywolfmesh/*
!work/models/crywolfmesh/pesos.json
!work/models/crywolfmesh/giros.json
!work/models/xenodogmesh/
work/models/xenodogmesh/*
!work/models/xenodogmesh/pesos.json
!work/models/xenodogmesh/giros.json
# El volcado del 19/09: de aqui salen los cortes de `regiones` y la tupla
# `sin_claves`, o sea que es la PRUEBA de que no se eligieron a ojo.
!work/models/xenodogmesh/volcado.txt
work/textures/
# Volcados de pose de Blender: 50-60 MB cada uno, siete de ellos, y se
# regeneran corriendo Pose-NMSMesh.py sobre los .ANIM del juego.
*.npz
*.blend
# 20,9 MB. Decision del humano el 2026-08-15: entra, para que el proyecto de
# Blender quede reproducible sin depender de volver a correr el script.
!BLENDER/proyectos/scuttler.blend
*.blend1
*.psd
*.xcf

# --- Releases empaquetados (van a Nexus, no a git) ---
releases/*
!releases/.gitkeep

# --- Config local de herramientas ---
.claude/settings.local.json

# --- Sistema / editor ---
Thumbs.db
desktop.ini
Desktop.ini
*.tmp
*.bak
~$*
.vscode/
.idea/
.obsidian/

# --- Excepciones: esto SI se versiona ---
!.gitignore
!.gitkeep

# --- Grafo Logseq (local, no se versiona) ---
# logseq-graph/pages es un junction NTFS a docs/: los .md reales ya estan
# versionados ahi. Aqui solo hay metadatos e indices de Logseq.
logseq-graph/

# --- Excepcion: las capturas de las fichas de modelo ---
# Son renders NUESTROS de mallas NUESTRAS, no arte de terceros, y sin ellas
# las fichas de docs/MODELOS/ no se entienden.
!docs/MODELOS/img/
!docs/MODELOS/img/*.png
